#/etc/systemd/system/sj-audio-sendspin.service
[Unit]
Description="Soundjar Audio (Sendspin)"
Conflicts=sj-audio-bluetooth.service
After=sj-audio-bluetooth.service
Wants=sendspin-cli
Before=sendspin-cli
PropagatesStopTo=sendspin-cli
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart= #LED-Effekt hier!
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target